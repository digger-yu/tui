# 复制此文件为 .env 并填写你的密钥

# ============================================
# 多账户配置 (推荐方式)
# ============================================
# 使用 JSON 格式配置多个 Twitter 账户和对应手机号
# 示例: 监控 aleabitoreddit 和 elonmusk，都发送到 13xxxxxxxxx
# ACCOUNTS_JSON='[{"twitter_user":"aleabitoreddit","phones":["13xxxxxxxxx"]},{"twitter_user":"elonmusk","phones":["13xxxxxxxxx","13900139000"]}]'
ACCOUNTS_JSON='[{"twitter_user":"aleabitoreddit","phones":["13xxxxxxxxx"]}]'

# ============================================
# 单账户配置 (兼容旧版，不设置 ACCOUNTS_JSON 时使用)
# ============================================
TARGET_TWITTER_USER=aleabitoreddit
TARGET_PHONE=13xxxxxxxxx

# ============================================
# 飞书应用凭证 (必须)
# ============================================
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# 其他可选配置
# ============================================
# 每次获取推文数量
TWEETS_COUNT=10

# 轮询间隔 (秒，本地运行时使用)
POLLING_INTERVAL=300

# 翻译引擎: google, baidu, deepl
TRANSLATOR_ENGINE=google

# 飞书机器人 Webhook (可选，用于群消息)
FEISHU_WEBHOOK_URL=

# 百度翻译 API (可选)
BAIDU_APP_ID=
BAIDU_SECRET_KEY=

# DeepL API (可选)
DEEPL_API_KEY=
